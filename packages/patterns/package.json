    ".": "./dist/index.js",
    "./docs": "./dist/docs.js"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carvalhorafael/eumilitar-design-system.git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
